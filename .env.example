# Copy this file to .env for local development, or set these as
# environment variables in your hosting dashboard (e.g. Railway).

# Any long random string - used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Optional - Railway sets this automatically
PORT=3000
